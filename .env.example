# string: development | production | test
NODE_ENV=

# string: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=

# number: HTTP API port
PORT=

# string: frontend origin URL, for example https://i18nshaman.com
FRONTEND_URL=

# string: session secret
SECRET=

# string: MongoDB host, without protocol, credentials, port or database name
MONGO_HOST=

# number: MongoDB port
MONGO_PORT=

# string: MongoDB database name
MONGO_DB_NAME=

# string: MongoDB username
MONGO_DB_USER=

# string: MongoDB password
MONGO_DB_PASSWORD=

# string: MongoDB authentication database, usually admin
MONGO_AUTH_SOURCE=

# string: SMTP host
SMTP_HOST=

# number: SMTP port, usually 465 or 587
SMTP_PORT=

# string: SMTP username
SMTP_USER=

# string: SMTP password
SMTP_PASS=

# string: email sender, for example "i18n Shaman" <no-reply@example.com>
SMTP_FROM=
