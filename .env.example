NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS and used in email links.
FRONTEND_URL=http://localhost:3000

# Required in production. Development uses a local fallback when omitted.
SECRET=change-me

# Use either MONGO_CONNECTION_URL or MONGO_URL + MONGO_DB_NAME.
MONGO_CONNECTION_URL=
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=i18nShaman

# Required for password reset and email verification flows.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="i18 Shaman" <no-reply@i18shaman.io>
