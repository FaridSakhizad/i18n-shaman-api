{
  "name": "i18nshaman-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "npm run build && node dist/main",
    "start:dev": "nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:dev:pretty": "nest build --webpack --webpackPath webpack-hmr.config.js --watch | pino-pretty",
    "start:debug": "nest start --debug --watch",
    "start:prod:pretty": "node dist/main | pino-pretty",
    "start:prod": "node dist/main",
    "logs:pretty": "journalctl -u i18nshaman-api -f -o cat | pino-pretty",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cssnano": "^8.0.10",
    "dotenv": "^17.2.1",
    "express-session": "^1.19.0",
    "handlebars": "^4.7.9",
    "mjml": "^5.4.1",
    "mongoose": "^8.24.4",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "run-script-webpack-plugin": "^0.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.103.0",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "multer": "^2.3.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
